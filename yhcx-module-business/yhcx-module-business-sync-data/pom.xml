<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yhcx.boot</groupId>
        <artifactId>yhcx-module-business</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>yhcx-module-business-sync-data</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        同步数据
    </description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aws-crt.version>0.48.4</aws-crt.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.yhcx.boot</groupId>
            <artifactId>yhcx-module-business-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.yhcx.boot</groupId>
            <artifactId>yhcx-module-system-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.yhcx.boot</groupId>
            <artifactId>yhcx-module-infra-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <!-- AWS SDK for Java 2.x -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- Apache HttpClient 5.x：AWS SDK 2.x 的 Apache5 HTTP Client。版本由根 BOM 统一锁定。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache5-client</artifactId>
        </dependency>
        <!--
             保留直接声明，确保 Spring Boot 的 5.1.x 管理不会在最终运行包中抢回版本。
             根 yhcx-dependencies 已锁定 httpclient5 5.6.4 / httpcore5 5.4.3。
        -->
        <!-- Apache HttpClient 5 runtime dependencies -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3-transfer-manager</artifactId>
        </dependency>

        <!-- AWS CRT-based S3 client：大文件/高吞吐上传使用 -->
        <dependency>
            <groupId>software.amazon.awssdk.crt</groupId>
            <artifactId>aws-crt</artifactId>
            <version>${aws-crt.version}</version>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.yhcx.boot</groupId>
            <artifactId>yhcx-spring-boot-starter-file</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>

        <!-- Redis：用于数据集文件同步的分布式锁，防止同一数据集被并发触发。 -->
        <dependency>
            <groupId>com.yhcx.boot</groupId>
            <artifactId>yhcx-spring-boot-starter-redis</artifactId>
        </dependency>
    </dependencies>

</project>